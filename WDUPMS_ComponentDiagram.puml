@startuml WDUPMS_Component_Diagram

' ============================================
' WOLDIA UNIVERSITY PROPERTY MANAGEMENT SYSTEM
' UML Component Diagram
' Figure 4.X: System Component Architecture
' ============================================

!define FRONTEND_COLOR #E3F2FD
!define BACKEND_COLOR #FFF3E0
!define DATABASE_COLOR #E8F5E9
!define SERVICE_COLOR #F3E5F5

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #424242
    BorderThickness 1.5
    FontSize 10
    ArrowColor #616161
    ArrowThickness 1.2
}

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #757575
    BorderThickness 2
    FontSize 11
    FontStyle bold
}

skinparam interface {
    BackgroundColor #FFFFFF
    BorderColor #1976D2
    BorderThickness 1.5
}

' ============================================
' PRESENTATION LAYER
' ============================================

package "Presentation Layer" FRONTEND_COLOR {
    
    component "Next.js Frontend" as frontend {
        portin " " as frontendIn
        portout " " as frontendOut
    }
    
    component "React Components" as reactComponents {
        component "Dashboard UI" as dashboardUI
        component "Asset Management UI" as assetUI
        component "Request Forms" as requestForms
        component "Transfer UI" as transferUI
        component "Reports UI" as reportsUI
    }
    
    component "State Management" as stateManagement {
        component "Context API" as contextAPI
        component "Local State" as localState
    }
    
    component "API Client" as apiClient {
        component "Axios/Fetch" as httpClient
        component "JWT Handler" as jwtHandler
    }
}

' ============================================
' APPLICATION LAYER
' ============================================

package "Application Layer" BACKEND_COLOR {
    
    ' API Gateway
    component "Express Router" as router {
        portin " " as routerIn
        portout " " as routerOut
    }
    
    ' Middleware
    component "Middleware Stack" as middlewareStack {
        component "Authentication" as authMiddleware
        component "Authorization" as roleMiddleware
        component "Validation" as validationMiddleware
        component "Error Handler" as errorHandler
        component "Audit Logger" as auditMiddleware
    }
    
    ' Controllers
    package "Controllers" {
        component "Auth Controller" as authController
        component "User Controller" as userController
        component "Asset Controller" as assetController
        component "Request Controller" as requestController
        component "Transfer Controller" as transferController
        component "Return Controller" as returnController
        component "Procurement Controller" as procurementController
        component "Report Controller" as reportController
    }
    
    ' Services (Business Logic)
    package "Services" {
        component "User Service" as userService
        component "Asset Service" as assetService
        component "Request Service" as requestService
        component "Transfer Service" as transferService
        component "Return Service" as returnService
        component "Workflow Service" as workflowService
        component "Notification Service" as notificationService
        component "Report Service" as reportService
    }
    
    ' Supporting Services
    component "JWT Service" as jwtService
    component "Email Service" as emailService
    component "File Service" as fileService
}

' ============================================
' DATA LAYER
' ============================================

package "Data Layer" DATABASE_COLOR {
    
    component "Sequelize ORM" as sequelizeORM {
        portin " " as ormIn
        portout " " as ormOut
    }
    
    ' Models
    package "Models" {
        component "User Model" as userModel
        component "Asset Model" as assetModel
        component "Request Model" as requestModel
        component "Transfer Model" as transferModel
        component "Return Model" as returnModel
        component "ProcurementWorkflow Model" as workflowModel
        component "ProcurementInspection Model" as inspectionModel
        component "AuditLog Model" as auditLogModel
        component "Notification Model" as notificationModel
        component "TransferHistory Model" as historyModel
    }
    
    component "Database Connection" as dbConnection {
        component "Connection Pool" as connectionPool
        component "Query Builder" as queryBuilder
    }
}

' ============================================
' EXTERNAL SYSTEMS
' ============================================

package "External Systems" SERVICE_COLOR {
    component "PostgreSQL Database" as postgres
    component "Email Server (SMTP)" as emailServer
    component "File Storage" as fileStorage
}

' ============================================
' INTERFACES
' ============================================

interface "REST API" as restAPI
interface "Database Protocol" as dbProtocol
interface "SMTP Protocol" as smtpProtocol

' ============================================
' CONNECTIONS - PRESENTATION TO APPLICATION
' ============================================

frontend -down-> reactComponents
reactComponents -down-> stateManagement
stateManagement -down-> apiClient
apiClient -down-> restAPI : "HTTPS/JSON"

' ============================================
' CONNECTIONS - APPLICATION LAYER INTERNAL
' ============================================

restAPI -down-> router
router -down-> middlewareStack

middlewareStack -down-> authController
middlewareStack -down-> userController
middlewareStack -down-> assetController
middlewareStack -down-> requestController
middlewareStack -down-> transferController
middlewareStack -down-> returnController
middlewareStack -down-> procurementController
middlewareStack -down-> reportController

authController -down-> jwtService
userController -down-> userService
assetController -down-> assetService
requestController -down-> requestService
transferController -down-> transferService
returnController -down-> returnService
procurementController -down-> workflowService
reportController -down-> reportService

userService -down-> notificationService
requestService -down-> workflowService
workflowService -down-> notificationService
notificationService -down-> emailService

' ============================================
' CONNECTIONS - APPLICATION TO DATA
' ============================================

userService -down-> sequelizeORM
assetService -down-> sequelizeORM
requestService -down-> sequelizeORM
transferService -down-> sequelizeORM
returnService -down-> sequelizeORM
workflowService -down-> sequelizeORM
reportService -down-> sequelizeORM

sequelizeORM -down-> userModel
sequelizeORM -down-> assetModel
sequelizeORM -down-> requestModel
sequelizeORM -down-> transferModel
sequelizeORM -down-> returnModel
sequelizeORM -down-> workflowModel
sequelizeORM -down-> inspectionModel
sequelizeORM -down-> auditLogModel
sequelizeORM -down-> notificationModel
sequelizeORM -down-> historyModel

userModel -down-> dbConnection
assetModel -down-> dbConnection
requestModel -down-> dbConnection
transferModel -down-> dbConnection
returnModel -down-> dbConnection
workflowModel -down-> dbConnection
inspectionModel -down-> dbConnection
auditLogModel -down-> dbConnection
notificationModel -down-> dbConnection
historyModel -down-> dbConnection

' ============================================
' CONNECTIONS - TO EXTERNAL SYSTEMS
' ============================================

dbConnection -down-> dbProtocol
dbProtocol -down-> postgres

emailService -down-> smtpProtocol
smtpProtocol -down-> emailServer

fileService -down-> fileStorage

' ============================================
' NOTES
' ============================================

note right of frontend
  **Responsibilities:**
  - User interface rendering
  - Client-side validation
  - State management
  - API communication
end note

note right of middlewareStack
  **Responsibilities:**
  - JWT token validation
  - Role-based access control
  - Input validation
  - Error handling
  - Audit logging
end note

note right of sequelizeORM
  **Responsibilities:**
  - Database abstraction
  - Query building
  - Model associations
  - Transaction management
end note

@enduml
